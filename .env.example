# Snowflake connection settings for local notebooks / tooling.
# Copy to .env and fill in locally. Never commit the populated file.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=EURORETAIL_WH
SNOWFLAKE_DATABASE=EURORETAIL_DB
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_ROLE=

# AWS values are intentionally not stored in this repository.
# S3 access is performed through the Snowflake storage integration.
S3_BUCKET=euro-retails
S3_PREFIX=raw/
